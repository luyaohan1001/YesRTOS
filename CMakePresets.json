{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "armv7m",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/kernel/arch/armv7m/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "ARCH_DEFINED": "ARMV7M"
      }
    },
    {
      "name": "stm32f767",
      "displayName": "STM32F767 (Cortex-M7, hardware)",
      "inherits": "armv7m",
      "cacheVariables": {
        "BOARD": "stm32f767"
      }
    },
    {
      "name": "qemu",
      "displayName": "QEMU netduinoplus2 (Cortex-M4F)",
      "inherits": "armv7m",
      "cacheVariables": {
        "BOARD": "netduinoplus2"
      }
    },
    {
      "name": "qemu-ast1030",
      "displayName": "QEMU ast1030-evb (Aspeed AST1030, Cortex-M4F)",
      "inherits": "armv7m",
      "cacheVariables": {
        "BOARD": "ast1030"
      }
    },
    {
      "name": "qemu-stress",
      "displayName": "QEMU netduinoplus2, 10 kHz timeslice to stress preemption",
      "inherits": "qemu",
      "cacheVariables": {
        "TIMESLICE_FREQ_HZ": "10000"
      }
    }
  ],
  "buildPresets": [
    { "name": "stm32f767",   "configurePreset": "stm32f767" },
    { "name": "qemu",        "configurePreset": "qemu" },
    { "name": "qemu-stress", "configurePreset": "qemu-stress" },
    { "name": "qemu-ast1030", "configurePreset": "qemu-ast1030" }
  ],
  "testPresets": [
    { "name": "qemu",        "configurePreset": "qemu",        "output": { "outputOnFailure": true } },
    { "name": "qemu-stress", "configurePreset": "qemu-stress", "output": { "outputOnFailure": true } },
    { "name": "qemu-ast1030", "configurePreset": "qemu-ast1030", "output": { "outputOnFailure": true } }
  ]
}
