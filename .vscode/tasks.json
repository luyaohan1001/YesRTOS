{
    "tasks": [
        {
            "type": "shell",
            "label": "reset",
            "command": "rm -rf ${workspaceFolder}/build"
        },
        {
            // Presets are defined in CMakePresets.json; each preset builds into build/<preset>.
            "type": "shell",
            "label": "CMake build debug",
            "command": "cmake --preset stm32f767 && cmake --build --preset stm32f767",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "CMake build release",
            "command": "cmake --preset stm32f767 -B build/stm32f767-release -DCMAKE_BUILD_TYPE=Release && cmake --build build/stm32f767-release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "CMake build qemu",
            "command": "cmake --preset qemu && cmake --build --preset qemu",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}
